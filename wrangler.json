{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wyd-meal-reservation",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "wyd-meal-reservation.online/*",
      "zone_id": "7202b8ba51ed66f4a1997ed1f5c50a4a"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wyd-meal-reservation-db",
      "database_id": "4ad9a39c-8570-4604-b425-5e0c862ab816",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
